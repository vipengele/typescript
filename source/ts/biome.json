{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 140
  },
  "plugins": [
    {
      "path": "./biome/no-node-imports.grit",
      "includes": ["**/src/**/*.ts", "!**/*.test.ts"]
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "security": "error",
      "correctness": "error"
    }
  },
  "overrides": [
    {
      "includes": ["biome/*.mjs"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noProcessGlobal": "off"
          }
        }
      }
    }
  ]
}
