{
  "name": "@vipengele/ts-core-http",
  "version": "0.2.1",
  "description": "HTTP client primitives for the browser and Node, built on fetch with redaction and resilience policies.",
  "keywords": [
    "vipengele",
    "typescript",
    "http",
    "fetch",
    "client"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vipengele/typescript.git",
    "directory": "source/core/packages/http"
  },
  "homepage": "https://github.com/vipengele/typescript/tree/main/source/core/packages/http#readme",
  "bugs": "https://github.com/vipengele/typescript/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@vipengele/ts-core-common": "workspace:*",
    "@vipengele/ts-core-redaction": "workspace:*",
    "@vipengele/ts-core-resilience": "workspace:*"
  }
}
